PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
SESSION_COOKIE_NAME=vendor_session
COOKIE_SECURE=false
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB_NAME=estanisrate
# Optional: comma-separated DNS servers if the local resolver blocks SRV queries.
MONGODB_DNS_SERVERS=
